# ---- upstream -----------------------------------------------------------------
# Anthropic API or any compatible gateway
UPSTREAM_URL=https://api.anthropic.com
# Key for the structurer/audit calls. Empty = reuse the client's own credentials.
# Required by the benchmark (bench.ps1), which calls the API directly.
ANTHROPIC_API_KEY=

# ---- what gets processed --------------------------------------------------------
# true -> only touch requests that carry tools (the agent main loop in Claude Code);
#         client side tasks like tab titles or summaries pass untouched.
# Set false for plain SDK usage without tools.
REQUIRE_TOOLS=true
# Prompts shorter than this are not rewritten (unless they carry 2+ signals).
# Length never decides the model: see CLASSIFY_SHORT.
MIN_CHARS=400

# ---- improving the prompt -------------------------------------------------------
# Give the structurer/classifier the context the main model sees: CLAUDE.md files and memory
# index (sent cached), environment (working dir, platform, date) and the last messages.
# Taken from the request itself, so it works in any project with nothing to configure.
CONTEXT=true
CONTEXT_MAX_CHARS=30000
CONTEXT_TURNS=6
# Context that travels with the interceptor (other PCs, clients without CLAUDE.md). Goes to the repo.
PROFILE_FILE=perfil.md
STRUCTURER_MODEL=claude-haiku-4-5-20251001
# seconds; 0 = no limit (the interpreter finishes its work; only connecting is bounded to 10 s)
STRUCTURER_TIMEOUT=0
# rewrite -> Claude gets the improved prompt first, your original attached as reference
# append  -> Claude gets your original first, plus a JSON structure block
INJECT_MODE=rewrite
# true -> requests the structurer marks as "simple" are only classified/routed, never rewritten
SKIP_SIMPLE=true
# Deterministic check that the rewrite kept every exact value of your message
VERIFY=true
# Collapse repeated log lines (same line, different timestamp) in big pasted messages
COMPRESS=true
COMPRESS_MIN_CHARS=3000

# ---- model routing --------------------------------------------------------------
# off     -> always the model the client asked for (manual #model:xxx still works)
# shadow  -> logs which model the rules WOULD pick, changes nothing (start here)
# enforce -> applies the rules in ROUTES_FILE
ROUTING_MODE=off
ROUTES_FILE=routes.json
# Used only when ROUTES_FILE is missing (single rule: simple -> this model)
MODEL_SIMPLE=claude-haiku-4-5-20251001
# Don't switch models when the conversation history is bigger than this (switching drops the
# prompt cache of the whole conversation, which can cost more than the cheaper model saves)
ROUTE_MAX_HISTORY_CHARS=100000
# With routing on (shadow/enforce), short messages are still classified by complexity with a
# light Haiku call (previous answer included as context) so the model depends on the work, not
# the length. Pure continuations ("dale", "ok seguí") skip the call and keep the previous turn's model.
CLASSIFY_SHORT=true

# ---- observability ----------------------------------------------------------------
# Background check of each final answer against the success criteria (one extra Haiku call
# per turn, never adds latency). Results in the log and in metrics.
AUDIT=false
# JSONL record of every request, summarized by report.ps1 (cache per model, routing, audits)
METRICS_ENABLED=false
METRICS_PATH=./metrics.jsonl

# ---- runtime ------------------------------------------------------------------------
CACHE_SIZE=512
FAIL_OPEN=true
# LOG_FILE is set automatically in background mode (interceptor.log)
# Background start (autostart.ps1 / autostart.sh) runs `git pull --ff-only` first; never blocks start
AUTO_UPDATE=true
HOST=127.0.0.1
PORT=8787

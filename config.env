# config.env - configuracion del interceptor que VIAJA con el repo (sin secretos).
# .env (no se sube) pisa cualquier valor de aca y es el lugar de ANTHROPIC_API_KEY.
# Todas las opciones estan documentadas en .env.example.
UPSTREAM_URL=https://api.anthropic.com
STRUCTURER_MODEL=claude-haiku-4-5-20251001
# 0 = sin limite: el interprete termina su trabajo (solo conectarse tiene 10 s)
STRUCTURER_TIMEOUT=0
MIN_CHARS=400
ROUTING_MODE=enforce
ROUTES_FILE=routes.json
MODEL_SIMPLE=claude-haiku-4-5-20251001
CONTEXT=true
PROFILE_FILE=perfil.md
# metricas por prompt (interprete, modelo, effort, cache) para ver que combinacion rinde mejor
METRICS_ENABLED=true
METRICS_PATH=./metrics.jsonl
CACHE_SIZE=512
FAIL_OPEN=true
# al arrancar en segundo plano hace git pull (trae los PRs mergeados); sin red sigue igual
AUTO_UPDATE=true
HOST=127.0.0.1
PORT=8787
